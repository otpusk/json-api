{
  "name": "@otpusk/json-api",
  "version": "1.0.136",
  "description": "",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./dist/geo/ukraine": {
      "import": "./dist/esm/geo/ukraine/index.js",
      "require": "./dist/cjs/geo/ukraine/index.js"
    },
    "./dist/normalize/schemas": {
      "import": "./dist/esm/normalize/schemas/index.js",
      "require": "./dist/cjs/normalize/schemas/index.js"
    },
    "./dist/*": {
      "import": "./dist/esm/*.js",
      "require": "./dist/cjs/*.js"
    }
  },
  "scripts": {
    "transpile": "rm -rf dist && BABEL_ENV=cjs babel src --out-dir dist/cjs && BABEL_ENV=esm babel src --out-dir dist/esm",
    "start": "webpack-dev-server",
    "publish-package": "npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otpusk/json-api.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/otpusk/json-api/issues"
  },
  "homepage": "https://github.com/otpusk/json-api#readme",
  "engines": {
    "node": ">=20"
  },
  "browserslist": [
    "since 2021"
  ],
  "devDependencies": {
    "@babel/cli": "7.24.5",
    "@babel/core": "7.24.5",
    "@babel/eslint-parser": "7.24.5",
    "@babel/node": "7.23.9",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "7.24.5",
    "babel-loader": "9.1.3",
    "eslint": "8.57.0",
    "eslint-plugin-react": "7.34.1",
    "html-webpack-plugin": "5.6.0",
    "webpack": "5.91.0",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.0.4"
  },
  "dependencies": {
    "@babel/runtime": "^7.29.7",
    "fetch-jsonp": "^1.1.3",
    "immutable": "4.0.0-rc.12",
    "js-cookie": "3.0.1",
    "localforage": "^1.7.3",
    "moment": "2.29.4",
    "normalizr": "^3.3.0",
    "ramda": "0.29.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "files": [
    "dist"
  ]
}
