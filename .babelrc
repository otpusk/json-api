{
    "env": {
        "cjs": {
            "presets": [
                [
                    "@babel/preset-env",
                    {
                        "modules": "commonjs"
                    }
                ]
            ]
        },
        "esm": {
            "presets": [
                [
                    "@babel/preset-env",
                    {
                        "modules": false
                    }
                ]
            ]
        }
    },
    "plugins": [
        [
            "@babel/plugin-transform-runtime",
            {
                "version": "7.29.7"
            }
        ]
    ]
}
